# Copier ce fichier en ".env" (non versionné) et renseigner les vraies valeurs.
# URL de connexion Neon (onglet "Connection string" du tableau de bord Neon).
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE.neon.tech/neondb?sslmode=require&channel_binding=require

# Connexion Neon SANS pooler (hôte sans "-pooler"), utilisée par scripts/migrate.py
# pour les changements de schéma. Optionnelle : à défaut, DATABASE_URL est utilisée.
DATABASE_URL_DIRECT=

# Clé secrète de signature des sessions administrateur (32 caractères minimum).
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
# Changer cette clé déconnecte tous les administrateurs.
UPB_SECRET_KEY=
# Durée d'une session administrateur, en heures (défaut 8)
UPB_SESSION_HOURS=8

# Journal d'activité (1 = activé, 0 = désactivé ; activé par défaut)
UPB_AUDIT_ENABLED=1

# Optionnel
UPB_DEFAULT_PER_PAGE=20
UPB_MAX_PER_PAGE=100
UPB_DB_CONNECT_TIMEOUT=10

# Mot de passe d'accès à la documentation /docs, /redoc, /openapi.json (10 caractères
# minimum), à remettre aux intégrateurs autorisés. Les administrateurs peuvent aussi
# s'y connecter avec leur identifiant et mot de passe.
UPB_DOCS_PASSWORD=
